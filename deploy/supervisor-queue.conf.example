; /etc/supervisor/conf.d/isp-cms-queue.conf
[program:isp-cms-queue]
command=php /var/www/isp-cms/artisan queue:work database --sleep=3 --tries=3 --max-time=3600
process_name=%(program_name)s_%(process_num)02d
numprocs=1
user=www-data
autostart=true
autorestart=true
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=/var/www/isp-cms/storage/logs/queue.log
