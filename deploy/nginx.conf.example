# /etc/nginx/sites-available/isp-cms  — sesuaikan <DOMAIN> dan versi PHP-FPM.
server {
    listen 80;
    server_name <DOMAIN> www.<DOMAIN>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <DOMAIN> www.<DOMAIN>;
    root /var/www/isp-cms/public;
    index index.php;

    # ssl_certificate & ssl_certificate_key diisi oleh certbot.

    client_max_body_size 60m;
    charset utf-8;
    server_tokens off;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/(build|storage/media)/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Jangan pernah mengeksekusi PHP di folder upload.
    location ~ ^/storage/.*\.php$ { deny all; }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* { deny all; }
}
